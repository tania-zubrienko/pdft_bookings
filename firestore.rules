rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Never delete users from client
    }
    
    // Classes collection - Public read for authenticated users
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Reservations collection
    match /reservations/{reservationId} {
      // Students can read their own reservations
      allow read: if isAuthenticated() && isOwner(resource.data.studentId);
      
      // Students can create reservations with 'pending' status only
      allow create: if isAuthenticated() 
                    && isOwner(request.resource.data.studentId)
                    && request.resource.data.status == 'pending';
      
      // No client-side updates or deletes - only Cloud Functions
      allow update, delete: if false;
    }
    
    // Payments collection - Read only for owner
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && isOwner(resource.data.studentId);
      allow write: if false; // Only Cloud Functions
    }
    
    // Credit Pools - Phase 2 (placeholder)
    match /creditPools/{poolId} {
      allow read: if isAuthenticated() && isOwner(resource.data.studentId);
      allow write: if false; // Only Cloud Functions
    }
    
    // Packages - Phase 2 (placeholder)
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
